{
  "shop": {
    "id": 714934229,
    "name": "ASUNMEE",
    "warehouse_alias": "ASUMEE",
    "currency": "VND",
    "auth": {
      "mode": "api_key",
      "env_keys": ["PANCAKE_POS_API_KEY", "PANCAKE_API_KEY"],
      "user_env": "PANCAKE_API_KEY_USER",
      "default_user": "ASUNMEE"
    },
    "base_url": "https://pos.pages.fm/api/v1"
  },
  "endpoints": {
    "ok": [
      "/shops/{shop_id}",
      "/shops/{shop_id}/orders",
      "/shops/{shop_id}/orders/{order_id}",
      "/shops/{shop_id}/customers",
      "/shops/{shop_id}/products",
      "/shops/{shop_id}/warehouses",
      "/shops/{shop_id}/pages"
    ],
    "missing": ["/shops/{shop_id}/settings"]
  },
  "warehouses": [
    {"name": "Kho Hà Nội", "role": "kho"},
    {"name": "Kho Ân Thi", "role": "kho"},
    {"name": "ASUMEE", "role": "kho_chinh_alias"}
  ],
  "pii_mask": {
    "policy": "api_key returns Pancake redaction — NOT ciphertext; cannot decrypt ****",
    "detail_unmasks": false,
    "customers_unmasks": false,
    "patterns": [
      "+84NNN****NN",
      "H** N***",
      "61**** Xã*********"
    ],
    "fields": [
      "bill_phone_number",
      "bill_full_name",
      "shipping_address.phone_number",
      "shipping_address.full_name",
      "shipping_address.address",
      "shipping_address.full_address",
      "shipping_address.marketplace_address",
      "customer.name",
      "customer.phone_numbers[]",
      "customer.shop_customer_addresses[].phone_number",
      "customer.shop_customer_addresses[].full_name",
      "customer.shop_customer_addresses[].address",
      "customer.shop_customer_addresses[].full_address",
      "histories[].bill_phone_number.new",
      "histories[].bill_full_name.new",
      "histories[].shipping_address.new.phone_number",
      "histories[].shipping_address.new.full_name",
      "histories[].shipping_address.new.address",
      "histories[].shipping_address.new.full_address"
    ]
  },
  "clear_fields_useful": [
    "id",
    "status",
    "status_name",
    "total_price",
    "shipping_fee",
    "note",
    "tracking_link",
    "warehouse_id",
    "warehouse_info.name",
    "warehouse_info.phone_number",
    "warehouse_info.address",
    "page.name",
    "inserted_at",
    "updated_at",
    "partner",
    "order_sources_name"
  ],
  "decode_assist": {
    "mask": {
      "kind": "mask",
      "ok": false,
      "assist": "Không giải được mask ASUNMEE — cần export/JWT full PII owned hoặc AEAD nội bộ có key"
    },
    "frida_aes": {
      "kind": "aes-gcm",
      "need_env": "MAPPER_ICON_AES_KEY_B64",
      "note": "Frida AES unwrap ≠ unmask Pancake PII"
    },
    "aead_at_rest": {
      "cli": "python3 scripts/crypto_decode_assist.py --aes-gcm KEY_B64 NONCE_B64 CT_B64"
    },
    "cli": "python3 scripts/crypto_decode_assist.py --asunmee"
  },
  "user_flow": [
    "1. Xác nhận đơn thuộc shop 714934229 (ASUNMEE) qua api_key owned",
    "2. Phân loại trường: MASK vs CLEAR vs ENCODED (crypto_decode_assist)",
    "3. Nếu MASK **** → không decode; hướng dẫn nguồn unmask hợp lệ (CS export / AEAD owned)",
    "4. Nếu Frida bundle ciphertext → cần MAPPER_ICON_AES_KEY_B64",
    "5. Pipe đơn clear-fields vào kho/BC DB; PII mask giữ nguyên + gắn assist=mask"
  ]
}
