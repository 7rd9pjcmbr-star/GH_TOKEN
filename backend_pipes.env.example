# Sao chép: cp backend_pipes.env.example secrets/backend_pipes.env
# Chỉ điền credential OWNED (dashboard shop). Không paste dump Acc_all/stealer.
# File secrets/* được gitignore.
#
# Đổi/refresh token gọi đơn realtime:
#   python3 scripts/access_token_rotate.py set --platform GHN --token …
#   python3 scripts/access_token_rotate.py refresh --platform ViettelPost
#   python3 scripts/access_token_rotate.py apply-realtime
# Xem docs/ACCESS-TOKEN-ROTATE.md

# ─── Mapping user/token sở hữu (dùng khi chạy sync/mapper) ───
# Ưu tiên: PLATFORM_USER + PLATFORM_TOKEN + PLATFORM_SHOP_ID
# Hoặc: OWNED_MAP_<PLATFORM>=user|token|shop_id
# Hoặc: OWNED_ACCOUNTS_JSON=[{...}]

# Pancake POS
PANCAKE_USER=
PANCAKE_POS_API_KEY=
# PANCAKE_POS_ACCESS_TOKEN=
PANCAKE_SHOP_ID=1530618
# OWNED_MAP_PANCAKE=user|token|1530618

# GHN
GHN_USER=
GHN_API_TOKEN=
GHN_SHOP_ID=
# OWNED_MAP_GHN=090xxxxxxx|ghn_token_here|shop_id

# ViettelPost (token sau login owned — không dùng dump)
# refresh: python3 scripts/access_token_rotate.py refresh --platform ViettelPost
VIETTELPOST_USER=
VIETTELPOST_TOKEN=
# VIETTELPOST_PASSWORD=
VIETTELPOST_SHOP_ID=

# TPOS
TPOS_USER=
TPOS_BASE_URL=
TPOS_ACCESS_TOKEN=
TPOS_SHOP_ID=

# Sapo
SAPO_USER=
SAPO_ACCESS_TOKEN=
SAPO_STORE=
# SAPO_BASE_URL=

# Nhanh.vn
NHANH_USER=
NHANH_API_KEY=
NHANH_BUSINESS_ID=
# NHANH_APP_ID=

# Shopee / SPX
SHOPEE_USER=
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=
# SHOPEE_PARTNER_ID=
SPX_USER=
SPX_TOKEN=
SPX_SHOP_ID=

# VNPost
VNPOST_USER=
VNPOST_TOKEN=
VNPOST_CUSTOMER_CODE=

# Aship tracking (optional)
# ASHIP_API_KEY=

# Multi-account JSON (optional)
# OWNED_ACCOUNTS_JSON=[{"platform":"GHN","user":"0901...","token":"...","shop_id":"123","label":"kho-hcm"}]

# Telegram (thường nằm ở secrets/telegram.env)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_USERNAME=
